--- a/apps/cadcraft/src/save_names.rs
+++ b/apps/cadcraft/src/save_names.rs
@@ -0,0 +1,22 @@
+//! Preserve explicit export formats; give bare names the dialog's suggested drawing suffix.
+use std::path::{Path, PathBuf};
+
+pub fn normalized(path: &Path, suggested: &str) -> PathBuf {
+    if path.extension().is_some_and(|e| !e.is_empty()) {
+        return path.to_path_buf();
+    }
+    let ext = Path::new(suggested).extension().and_then(|e| e.to_str()).filter(|e| e.eq_ignore_ascii_case("dwg")).unwrap_or("dxf");
+    path.with_extension(ext)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn drawing_names_and_explicit_exports() {
+        assert_eq!(normalized(Path::new("plate"), "Drawing.dxf"), Path::new("plate.dxf"));
+        assert_eq!(normalized(Path::new("plate"), "Drawing.dwg"), Path::new("plate.dwg"));
+        assert_eq!(normalized(Path::new("sheet.pdf"), "Drawing.dxf"), Path::new("sheet.pdf"));
+        assert_eq!(normalized(Path::new("original.DWG"), "Drawing.dxf"), Path::new("original.DWG"));
+    }
+}

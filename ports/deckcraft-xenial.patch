+//! Keep this VAIO's existing XScreenSaver awake only while presenting.
+//! Xenial xdg-screensaver selects the installed xautolock backend instead.
+//! The worker belongs to this process; neither settings nor a daemon are changed.
+use std::sync::mpsc::{self, RecvTimeoutError, Sender};
+use std::time::Duration;
+
+#[derive(Default)]
+pub struct Inhibitor {
+    showing: bool,
+    worker: Option<Sender<bool>>,
+}
+
+impl Inhibitor {
+    pub fn update(&mut self, showing: bool) {
+        if showing == self.showing {
+            return;
+        }
+        if self.worker.is_none() {
+            let (sender, receiver) = mpsc::channel::<bool>();
+            std::thread::spawn(move || {
+                let mut active = false;
+                loop {
+                    match receiver.recv_timeout(Duration::from_secs(45)) {
+                        Ok(showing) => active = showing,
+                        Err(RecvTimeoutError::Timeout) => {}
+                        Err(RecvTimeoutError::Disconnected) => break,
+                    }
+                    if active {
+                        match std::process::Command::new("/usr/bin/xscreensaver-command")
+                            .arg("-deactivate")
+                            .stdin(std::process::Stdio::null())
+                            .stdout(std::process::Stdio::null())
+                            .stderr(std::process::Stdio::null())
+                            .status()
+                        {
+                            Ok(status) if status.success() => {}
+                            result => log::warn!("presentation screensaver keepalive: {result:?}"),
+                        }
+                    }
+                }
+            });
+            self.worker = Some(sender);
+        }
+        if let Some(sender) = &self.worker {
+            let _ = sender.send(showing);
+        }
+        self.showing = showing;
+    }
+}

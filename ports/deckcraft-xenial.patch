@@ -0,0 +1,24 @@
+//! Keep the chosen format when older Zenity returns a bare save filename.
+use std::path::{Path, PathBuf};
+pub fn selected_path(picked: &Path, suggested: &str) -> PathBuf {
+    let mut selected = picked.to_path_buf();
+    if selected.extension().is_none_or(|extension| extension.is_empty()) {
+        selected.set_extension(Path::new(suggested).extension().filter(|ext| !ext.is_empty()).unwrap_or(std::ffi::OsStr::new("deckcraft")));
+    }
+    selected
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn bare_and_trailing_dot_names_use_the_suggested_format() {
+        assert_eq!(selected_path(Path::new("/tmp/talk"), "draft.pptx"), Path::new("/tmp/talk.pptx"));
+        assert_eq!(selected_path(Path::new("/tmp/talk."), "draft.deckcraft"), Path::new("/tmp/talk.deckcraft"));
+        assert_eq!(selected_path(Path::new("/tmp/export"), "draft.pdf"), Path::new("/tmp/export.pdf"));
+    }
+    #[test]
+    fn explicit_extensions_and_existing_parent_names_are_preserved() {
+        assert_eq!(selected_path(Path::new("/tmp/archive.v1/talk.PPTX"), "draft.deckcraft"), Path::new("/tmp/archive.v1/talk.PPTX"));
+        assert_eq!(selected_path(Path::new("/tmp/archive.v1/talk"), "draft"), Path::new("/tmp/archive.v1/talk.deckcraft"));
+    }
+}

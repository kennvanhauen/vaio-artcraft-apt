+#[cfg(any(test, all(target_os = "linux", target_arch = "x86")))]
+fn pdf_save_path(picked: &std::path::Path) -> PathBuf {
+    let mut path = picked.to_path_buf();
+    if path.extension().is_none_or(|extension| extension.is_empty()) {
+        path.set_extension("pdf");
+    }
+    path
+}
+
+#[cfg(test)]
+mod vaio_save_tests {
+    use super::pdf_save_path;
+    use std::path::Path;
+    #[test]
+    fn native_pdf_names_keep_typed_extensions_and_fill_missing_ones() {
+        assert_eq!(pdf_save_path(Path::new("/tmp/report")), Path::new("/tmp/report.pdf"));
+        assert_eq!(pdf_save_path(Path::new("/tmp/report.")), Path::new("/tmp/report.pdf"));
+        assert_eq!(pdf_save_path(Path::new("/tmp/report.PDF")), Path::new("/tmp/report.PDF"));
+        assert_eq!(pdf_save_path(Path::new("/tmp/report.custom")), Path::new("/tmp/report.custom"));
+    }
+}

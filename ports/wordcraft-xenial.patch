+/// Older Zenity does not add the selected default extension to a bare filename.
+fn selected_save_path(path: &std::path::Path, suggested: &str) -> std::path::PathBuf {
+    let mut selected = path.to_path_buf();
+    if path.extension().is_none_or(|extension| extension.is_empty()) {
+        let extension = save_exts(suggested).into_iter().next().unwrap_or_else(|| "docx".into());
+        selected.set_extension(extension);
+    }
+    selected
+}
